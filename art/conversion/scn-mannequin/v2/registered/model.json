    "rule": "Shared expanded frame adds4source units each side of the original cell; original physical pixels/scale retained. Reflect N about standx11.3 to preserve rotation pivot and fit the source long armature. No per-view/part alpha-bounds normalization; all masks share mapping."
  },
  "camera": {
    "classification": "CARDINAL_SOURCE_BOUND",
    "contract": "Selected straight front retained; N is the same featureless manufactured forms reversed about the central stand, not the image midpoint. Complete east and west profiles are authored separately for asymmetric limb/role overlap. No humanoid actor pose or face.",
    "authored_shell_depth": 2.2,
    "authored_head_profile_width": 2.1,
    "authored_profile_base_depth": 3.6,
    "dimension_provenance": "Unseen form thickness, profile armature depth/occlusion and stand strut directions are authored estimates informed by native biped-form glyph/description and actual donor profile volume; not native dimensions or a donor frame ratio.",
    "stand_center_source_x": 7.3,
    "stand_center_expanded_x": 11.3,
    "west": "Separate profile: pale right armature is far, colored left form is near. A mirror of the entire east would swap source role/laterality incorrectly."
  },
  "palette": {
    "primary": "y",
    "default_detail": "R; illustration only",
    "random_detail": "Actual native RandomColors DetailColor=all",
    "formula": "coverage*luminance*((1-detail_weight)*foreground+detail_weight*detail)+(1-coverage)*background"
  },
