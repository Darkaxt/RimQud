  "camera": {
    "contract": "Straight stacked fronts with parallel rectangular cap; complete end has substantial authored depth. No converging cap edges or yaw. Same16x24source cell/pivot8,16.",
    "authored_width": 11.9,
    "authored_depth": 7.5,
    "top_visibility_factor": 0.28,
    "depth_status": "Authored hidden depth guided by original broad cap and actual directional reference, not native Qud measurements.",
    "front_correction": "Preserve existing body/front/pull/foot material and replace only the receding trapezoid cap geometry with a parallel plane. Reuse existing cap material by row-wise surface-coordinate remapping; no separate AI front redraw.",
    "unseen": "Plain closed end/back wood with precise seam joinery. No front pulls or hidden brass rails are drawn onto unseen closed faces.",
    "west": "Mirror east; symmetric unmarked end and feet."
  },
