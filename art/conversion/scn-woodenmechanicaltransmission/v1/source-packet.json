  "entry": "SCN-WOODENMECHANICALTRANSMISSION",
  "identity": "WoodenMechanicalTransmission -> BaseMechanicalTransmission -> MountedFurniture -> Furniture",
  "description": "Wood was shaved, cut to smooth-volumed shafts, and fit inside gearboxes to convey motion in continuity.",
  "native_definition": {
    "path": "D:\\Steam\\steamapps\\common\\Caves of Qud\\CoQ_Data\\StreamingAssets\\Base\\ObjectBlueprints\\Furniture.xml",
    "sha256": "b3536f2debf912194e43e23eb5b96e10feafd97dbd4682c807732b2db19054ae",
    "objects": {
      "WoodenMechanicalTransmission": "<object Name=\"WoodenMechanicalTransmission\" Inherits=\"BaseMechanicalTransmission\">\n    <part Name=\"Render\" DisplayName=\"wooden machinery\" RenderString=\"216\" ColorString=\"&amp;w\" DetailColor=\"w\" Occluding=\"false\" />\n    <part Name=\"Physics\" Weight=\"200\" />\n    <part Name=\"Description\" Short=\"Wood was shaved, cut to smooth-volumed shafts, and fit inside gearboxes to convey motion in continuity.\" />\n    <part Name=\"MechanicalPowerTransmission\" ChargeRate=\"100\" IsTechScannable=\"false\" />\n    <part Name=\"Examiner\" Complexity=\"1\" Difficulty=\"1\" />\n    <part Name=\"TinkerItem\" Bits=\"B\" CanDisassemble=\"false\" CanBuild=\"false\" />\n    <stat Name=\"AV\" Value=\"2\" />\n    <stat Name=\"Hitpoints\" Value=\"50\" />\n    <tag Name=\"Tier\" Value=\"2\" />\n    <xtagGrammar massNoun=\"true\" />\n  </object>",
      "BaseMechanicalTransmission": "<object Name=\"BaseMechanicalTransmission\" Inherits=\"MountedFurniture\">\n    <part Name=\"MechanicalPowerTransmission\" IsConduit=\"true\" TileEffects=\"true\" TileBaseFromTag=\"PaintedFence\" TileAnimateWhenPowered=\"true\" TileAnimatePoweredFrames=\"3\" TileAppendWhenUnpowered=\"_1\" />\n    <part Name=\"MergeConduit\" ModPart=\"ModGearbox\" DestroyIfPart=\"MechanicalPowerTransmission\" />\n    <tag Name=\"PaintedFence\" Value=\"sw_axle\" />\n    <tag Name=\"PaintedFenceExtension\" Value=\".png\" />\n    <tag Name=\"PaintPart\" Value=\"MechanicalPowerTransmission\" />\n    <tag Name=\"ForceRepaintSolid\" />\n    <tag Name=\"BaseObject\" Value=\"*noinherit\" />\n    <part Name=\"Examiner\" Unknown=\"UnknownBizarreContraption\" Alternate=\"UnknownBizarreContraption\" />\n  </object>",
      "MountedFurniture": "<object Name=\"MountedFurniture\" Inherits=\"Furniture\">\n    <part Name=\"Render\" DisplayName=\"[MountedFurniture]\" />\n    <part Name=\"Physics\" Takeable=\"false\" />\n    <part Name=\"MountedFurniture\" />\n    <stat Name=\"Hitpoints\" Value=\"300\" />\n    <part Name=\"MissileCover\" Percentage=\"10\" />\n    <tag Name=\"OverlayColor\" Value=\"&amp;k^k\" />\n    <tag Name=\"BaseObject\" Value=\"*noinherit\" />\n  </object>",
      "Furniture": "<object Name=\"Furniture\" Inherits=\"InorganicObject\">\n    <part Name=\"Render\" RenderLayer=\"6\" Occluding=\"false\" RenderIfDark=\"true\" />\n    <part Name=\"Physics\" Conductivity=\"20\" Organic=\"false\" />\n    <part Name=\"Examiner\" Unknown=\"UnknownStrangeFurniture\" KeepTile=\"true\" />\n    <tag Name=\"Furniture\" Value=\"1\" />\n    <tag Name=\"BaseObject\" Value=\"*noinherit\" />\n    <stag Name=\"InsideFurniture\" />\n    <stag Name=\"InsideWallFurniture\" />\n    <tag Name=\"NeverStack\" />\n    <tag Name=\"NoAutoget\" Value=\"1\" />\n    <tag Name=\"Tier\" Value=\"0\" />\n    <part Name=\"Graffitied\" ChanceOneIn=\"300\" />\n    <tag Name=\"BlocksDoors\" />\n    <tag Name=\"DiscardInsteadOfGeneratingStacked\" Value=\"1\" />\n    <stag Name=\"Furniture\" />\n    <tag Name=\"TakeDamageSound\" Value=\"Sounds/Damage/sfx_damage_manufacturedWood\" />\n    <tag Name=\"DeathSounds\" Value=\"Sounds/Damage/sfx_destroy_manufacturedWood\" />\n    <tag Name=\"LairAmbientBed\" Value=\"Sounds/Ambiences/amb_creature_animatedFurniture\" />\n  </object>"
    }
