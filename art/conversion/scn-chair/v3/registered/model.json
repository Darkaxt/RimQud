  "camera": {
    "contract": "Retain corrected cardinal south plank chair. Complete right profile has broad rectangular hard seat and edge-on tall back. Rear back posts occlude the hard seat instead of being painted behind it.",
    "authored_front_width": 10.5,
    "authored_depth": 8.3,
    "depth_status": "Authored hidden seat depth guided by source proportions and legacy directional map camera; no runtime donor physical dimension inferred.",
    "unseen": "Rear/side plank joinery, far-support overlap and nail heads are authored continuation of the same right-angle frame. No padded seat, canvas, rounded back, armrests or new mechanism.",
    "west": "Mirror east; no asymmetric marks or side fittings."
  },
  "palette": {
    "primary": "w",
    "detail": "y",
    "formula": "coverage*luminance*((1-detail_weight)*foreground+detail_weight*detail)+(1-coverage)*background"
  },
  "native_state": "One fixed native chair tile. BaseChair supplies native Chair interaction,20-weight non-takeable organic furniture, MissileCover10, non-occlusion and rare Animated builder. No source facing selector or occupied tile is declared; rare animated/custom shapes require original fallback.",
