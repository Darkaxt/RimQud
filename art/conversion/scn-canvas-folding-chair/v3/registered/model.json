  "camera": {
    "contract": "Retain corrected south cardinal sling; complete east shows its full longitudinal seat extent rather than a thin edge. Parallel rails, vertical central axis, same16x24cell/pivot in every view. Diagonal X members are intrinsic bracing.",
    "authored_front_width": 11.1,
    "authored_depth": 7.6,
    "depth_status": "Authored estimate guided by source sling footprint and actual directional camera; no Qud hidden length or donor dimension claimed.",
    "side_structure": "Two transverse X frames fold across stool width. End view sees paired wooden struts edge-on under longitudinal side rails, not another frontal X pasted onto the side. Precise hidden supports are authored.",
    "rear_structure": "Backless stool has comparable front/rear outline. Rear wooden overlap/dowel face and sling underside are authored; no tall backrest or new folding mechanism.",
    "west": "Mirror east; no side-specific marks, accessories or asymmetric structure."
  },
