  "camera": {
    "contract": "Front-aligned closed box. Source top outline is physically shouldered: retain raised central lid and sloping shoulders, not a hidden isometric yaw. New end is broad rectangular depth with parallel front/back edges and full body volume.",
    "front_review": "Original native mask itself steps up at the lid and includes the two outer bright bands. Front walls/latch/bands remain vertically aligned; retained slope is interpreted as a raised shouldered lid, an authored source-bound shape rather than a recovered perspective plane.",
    "authored_width": 13.4,
    "authored_depth": 8.4,
    "depth_status": "Authored hidden depth informed by cardinal box reference and source width; not measured from JDS diagonal image or Qud upright icon.",
    "side": "Plain wood end, lid seam and visible return of wrap bands along lid shoulder. No new side handle or front latch pasted onto end.",
    "rear": "Closed rear with the same wrapping bands and two small primary-role hinge joins. Hinged-lid description supports hinges; exact placement/material remains authored. No rear latch or repeated front scratch layout.",
    "west": "Mirror east; unmarked symmetric end geometry and band returns."
  },
  "palette": {
    "primary": "w",
    "detail": "W",
    "formula": "coverage*luminance*((1-detail_weight)*foreground+detail_weight*detail)+(1-coverage)*background"
