    "rule": "One full-cell coordinate mapping for each complete layout and all tint masks. No independent drawer or top-box bbox centering."
  },
  "camera": {
    "contract": "Straight cardinal front, complete end, back and explicit west; vertical axes parallel. Shallow top bevel inherited from accepted fronts. No yaw or convergence of structural walls.",
    "front_review": "Existing fronts have straight vertical sides and only a shallow cap bevel; comparison with actual reference supports retaining them. No redraw is required to remove a three-quarter camera.",
    "width": 14,
    "depth": 8.8,
    "end_front_ratio": 0.6285714285714287,
    "depth_status": "Authored hidden depth informed by actual directional reference; upright Qud glyph does not establish it.",
    "unseen": "Plain galvanized side and rear panels with restrained folded-edge seams and short feet. These are authored surfaces, not source-established extra drawers, vents, machinery or storage states.",
    "variant2": "Same top storage box and two metal brackets; front handle does not appear on the rear/end. Rear x reflects the front x about shared pivot. Brackets overlap in end views. No radio/electronic interpretation."
  },
  "palette": {
    "primary": "c",
    "detail": "W",
    "formula": "coverage*luminance*((1-detail_weight)*foreground+detail_weight*detail)+(1-coverage)*background"
  },
  "state_owner": "Two actual RandomTile cosmetic layouts; each receives S/E/N/W authoring. No new open/closed state. South remains proposed fixed native tile; all extra directions unbound.",
  "inventory_boundary": "Argyve child changes InventoryPopulationTable to Argyve Cabinet but does not change render/shape. Actual inventory remains native and is not drawn as invented visible loot.",
  "native_behavior": "Preserve solid200-weight metal container, occluding=true, native inventory/smart-use and source random selection. No donor research/storage mechanics are transplanted.",
  "west_policy": "Explicit end views with front lip on opposite edges; no unexamined mirror assumption.",
  "native_acceptance": "Pending full-set generation gate; no runtime activation, native orientation/footprint or container acceptance."
