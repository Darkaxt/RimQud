{
  "entry": "SCN-JOPPA-BOOKSHELF",
  "identity": "Joppa Bookshelf -> Bookshelf -> BaseBookshelf -> MountedFurniture -> Furniture",
  "description": "Wood planks are nailed at orthogonal angles, and dust sleeps on the paper jackets.",
  "native_definition": {
    "path": "D:\\Steam\\steamapps\\common\\Caves of Qud\\CoQ_Data\\StreamingAssets\\Base\\ObjectBlueprints\\Furniture.xml",
    "sha256": "b3536f2debf912194e43e23eb5b96e10feafd97dbd4682c807732b2db19054ae",
    "objects": {
      "Joppa Bookshelf": "<object Name=\"Joppa Bookshelf\" Inherits=\"Bookshelf\">\n\t\t<part Name=\"Render\" DisplayName=\"wooden bookshelf\" Tile=\"Items/sw_bookshelf1.bmp\" DetailColor=\"W\" ColorString=\"&amp;w\" />\n\t\t<tag Name=\"NoSparkingQuest\" />\t\t\n\t\t<tag Name=\"InventoryPopulationTable\" Value=\"JoppaBookshelf\" />\n\t</object>",
      "Bookshelf": "<object Name=\"Bookshelf\" Inherits=\"BaseBookshelf\">\n    <builder Name=\"RandomTile\" Tiles=\"Items/sw_bookshelf1.bmp,Items/sw_bookshelf2.bmp,Items/sw_bookshelf3.bmp\" />    \n  </object>",
      "BaseBookshelf": "<object Name=\"BaseBookshelf\" Inherits=\"MountedFurniture\">\n\t\t<part Name=\"Render\" DisplayName=\"wooden bookshelf\" Tile=\"Items/sw_bookshelf1.bmp\" DetailColor=\"W\" ColorString=\"&amp;w\" RenderString=\"182\" />\n\t\t<part Name=\"Description\" Short=\"Wood planks are nailed at orthogonal angles, and dust sleeps on the paper jackets.\" />\n\t\t<part Name=\"Container\" Preposition=\"on\" OpenSound=\"Sounds/Interact/sfx_interact_open_bookshelf\" />\n\t\t<part Name=\"Inventory\" />\n\t\t<tag Name=\"FullDetailColor\" Value=\"W\" />\n\t\t<tag Name=\"EmptyDetailColor\" Value=\"k\" />\n\t\t<tag Name=\"NoSparkingQuest\" />\n\t\t<part Name=\"Physics\" Organic=\"true\" Weight=\"50\" />\n\t\t<tag Name=\"BaseObject\" Value=\"*noinherit\" />\n\t\t<tag Name=\"OverlayColor\" Value=\"&amp;w\" />\n\t\t<tag Name=\"HangingSupport\" />\n    <property Name=\"DontWarnOnOpen\" Value=\"true\" />\n\t</object>",
      "MountedFurniture": "<object Name=\"MountedFurniture\" Inherits=\"Furniture\">\n    <part Name=\"Render\" DisplayName=\"[MountedFurniture]\" />\n    <part Name=\"Physics\" Takeable=\"false\" />\n    <part Name=\"MountedFurniture\" />\n    <stat Name=\"Hitpoints\" Value=\"300\" />\n    <part Name=\"MissileCover\" Percentage=\"10\" />\n    <tag Name=\"OverlayColor\" Value=\"&amp;k^k\" />\n    <tag Name=\"BaseObject\" Value=\"*noinherit\" />\n  </object>",
      "Furniture": "<object Name=\"Furniture\" Inherits=\"InorganicObject\">\n    <part Name=\"Render\" RenderLayer=\"6\" Occluding=\"false\" RenderIfDark=\"true\" />\n    <part Name=\"Physics\" Conductivity=\"20\" Organic=\"false\" />\n    <part Name=\"Examiner\" Unknown=\"UnknownStrangeFurniture\" KeepTile=\"true\" />\n    <tag Name=\"Furniture\" Value=\"1\" />\n    <tag Name=\"BaseObject\" Value=\"*noinherit\" />\n    <stag Name=\"InsideFurniture\" />\n    <stag Name=\"InsideWallFurniture\" />\n    <tag Name=\"NeverStack\" />\n    <tag Name=\"NoAutoget\" Value=\"1\" />\n    <tag Name=\"Tier\" Value=\"0\" />\n    <part Name=\"Graffitied\" ChanceOneIn=\"300\" />\n    <tag Name=\"BlocksDoors\" />\n    <tag Name=\"DiscardInsteadOfGeneratingStacked\" Value=\"1\" />\n    <stag Name=\"Furniture\" />\n    <tag Name=\"TakeDamageSound\" Value=\"Sounds/Damage/sfx_damage_manufacturedWood\" />\n    <tag Name=\"DeathSounds\" Value=\"Sounds/Damage/sfx_destroy_manufacturedWood\" />\n    <tag Name=\"LairAmbientBed\" Value=\"Sounds/Ambiences/amb_creature_animatedFurniture\" />\n  </object>"
    }
  },
